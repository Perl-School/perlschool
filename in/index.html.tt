[% PROCESS util.tt -%]
      <div class="row">
        <div class="col-md-12">
          <h1>New Perl books are still worth publishing.</h1>
          <p>Traditional technical publishers have largely moved away from Perl.
            We haven't.</p>

          <p>Perl School is an independent publisher specialising in books for
            the Perl community. We publish practical books by experienced Perl
            developers—from broad introductions to highly specialised
            subjects—in ebook and paperback editions.</p>
        </div>
      </div>
      <div class="row">
        <div class="col-md-7">
[% IF feature.is_published -%]
          <h2 class="section-title">Latest Release</h2>
[% ELSE -%]
          <h2 class="section-title">Coming Soon</h2>
[% END -%]
        </div>
      </div>
      <div class="row hero align-items-center">
        <div class="col-lg-7">
	  <h3 class="display-3">[% feature.title | html %]</h3>
[% IF feature.subtitle -%]
          <p class="display-4">[% feature.subtitle | html %]</p>
[% END -%]
	  <p><b>By [% feature.author.name %]</b></p>
[% IF feature.is_published -%]
          <p class="muted">Published: [% feature.pubdate.strftime('%d %b %Y') %]</p>
[% END -%]

[% book_badges(feature) -%]

[% IF feature.upddate -%]
            <p class="muted">Latest update: [% feature.upddate.strftime('%d %b %Y') %]</p>
[% END -%]
          <p class="lead">[% feature.blurb %]</p>
          <div class="d-flex flex-wrap gap-2">
            <a href="/books/[% feature.slug %]/" class="btn btn-primary btn-lg">Read more...</a>
          </div>
	</div>
	<div class="col-lg-5 text-center">
	  <p class="mb-0"><span class="visually-hidden">Cover image</span> [% an_image(feature.image, feature.title, 'img-fluid') -%]</p>
	</div>
      </div>
